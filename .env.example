# ---- ML API (api/) ----
ENVIRONMENT=development            # set to "production" on Render (disables /docs)
# Local default is SQLite. For Supabase use the *pooler* connection string:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./data/mlab.db
# >= 32 random chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
BOOTSTRAP_ADMIN_KEY=
CORS_ORIGINS=http://localhost:8080,https://ml-lab.chakudya.xyz
# Base URL of the CNR API (never put its secrets in this repo)
CNR_API_BASE_URL=https://api.chakudya.xyz
# Path used by the dashboard's "Check CNR API" button (any HTTP answer counts as reachable)
CNR_API_HEALTH_PATH=/
CNR_API_TIMEOUT_S=5
# Lab -> CNR events (model deployed / rolled back / withdrawn). Off until both are set.
# The secret (>= 32 chars) must equal ML_LAB_WEBHOOK_SECRET on the CNR API. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
CNR_WEBHOOK_URL=https://api.chakudya.xyz/hooks/ml-lab
CNR_WEBHOOK_SECRET=

# ---- Dataset ingestion ----
# Where de-identified dataset versions are stored. On Render this must be on a persistent disk.
DATASET_STORAGE_DIR=./data/datasets
# >= 32 random chars. Enables the "pseudonymise" action (HMAC key). Keep it secret and stable:
# changing it changes every pseudonym, so versions made with different keys cannot be linked.
PSEUDONYM_KEY=
MAX_UPLOAD_MB=20
# A model must be reviewed by a different key than the one that registered/submitted it.
# Set to false only while one person holds every role (e.g. first trial run); never for real approvals.
REQUIRE_SEPARATE_REVIEWER=true

# ---- Limits ----
RATE_LIMIT_PREDICT_PER_MIN=60     # prediction requests per API key per minute
AUTH_FAIL_LIMIT=20                # wrong-key attempts per address per window before 429 (keeps the audit log clean)
AUTH_FAIL_WINDOW_S=300

# ---- Automatic surveillance sync (CNR -> laboratory) ----
# Pulls district-by-month counts from CNR's GET /surveillance/export (aggregates only), stores each change as a new
# dataset version and runs a hotspot analysis on it. Off until enabled AND the key is set.
SURVEILLANCE_SYNC_ENABLED=false
# An admin key of the CNR API (Authorization: Bearer ...). Sent only to CNR_API_BASE_URL. Keep it secret.
SURVEILLANCE_API_KEY=
SURVEILLANCE_SYNC_INTERVAL_HOURS=24
SURVEILLANCE_SYNC_MONTHS=12
# population_group:indicator pairs, comma separated. One dataset and one analysis per pair.
SURVEILLANCE_SYNC_TARGETS=under5:stunting,under5:wasting,under5:acute_malnutrition
SURVEILLANCE_SYNC_RUN_ANALYSIS=true

# ---- Automatic training-data sync (CNR -> laboratory) ----
# Pulls de-identified, record-level rows from CNR's GET /surveillance/training-export (groups under CNR's minimum size are
# left out) into a cnr-training-<model> dataset for each catalogue model that has a CNR source. Only fetches data; never
# trains or deploys. Uses the same CNR admin key as above. Off until enabled AND the key is set.
TRAINING_SYNC_ENABLED=false
# "all" or comma-separated model slugs. Models CNR cannot supply yet are reported, not fetched.
TRAINING_SYNC_MODELS=all
TRAINING_SYNC_INTERVAL_HOURS=24
TRAINING_SYNC_MONTHS=12
TRAINING_FETCH_MAX_MB=20
