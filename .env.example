# ---- ML API (api/) ----
ENVIRONMENT=development            # set to "production" on Render (disables /docs)
# Local default is SQLite. For Supabase use the *pooler* connection string:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./data/mlab.db
# >= 32 random chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
BOOTSTRAP_ADMIN_KEY=
CORS_ORIGINS=http://localhost:8080,https://ml-lab.chakudya.xyz
# Base URL of the CNR API (never put its secrets in this repo)
CNR_API_BASE_URL=https://api.chakudya.xyz
# Path used by the dashboard's "Check CNR API" button (any HTTP answer counts as reachable)
CNR_API_HEALTH_PATH=/
CNR_API_TIMEOUT_S=5
# Lab -> CNR events (model deployed / rolled back / withdrawn). Off until both are set.
# The secret (>= 32 chars) must equal ML_LAB_WEBHOOK_SECRET on the CNR API. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
CNR_WEBHOOK_URL=https://api.chakudya.xyz/hooks/ml-lab
CNR_WEBHOOK_SECRET=

# ---- Dataset ingestion ----
# Where de-identified dataset versions are stored. On Render this must be on a persistent disk.
DATASET_STORAGE_DIR=./data/datasets
# >= 32 random chars. Enables the "pseudonymise" action (HMAC key). Keep it secret and stable:
# changing it changes every pseudonym, so versions made with different keys cannot be linked.
PSEUDONYM_KEY=
MAX_UPLOAD_MB=20
# A model must be reviewed by a different key than the one that registered/submitted it.
# Set to false only while one person holds every role (e.g. first trial run); never for real approvals.
REQUIRE_SEPARATE_REVIEWER=true

# ---- Limits ----
RATE_LIMIT_PREDICT_PER_MIN=60     # prediction requests per API key per minute
AUTH_FAIL_LIMIT=20                # wrong-key attempts per address per window before 429 (keeps the audit log clean)
AUTH_FAIL_WINDOW_S=300
